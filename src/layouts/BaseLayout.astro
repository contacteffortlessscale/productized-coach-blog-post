---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    author: string;
    tags?: string[];
  };
}

const { title, description, image, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/logos/emblem-dark-green.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;600;700&display=swap"
    />

    <SEO title={title} description={description} image={image} article={article} />

    {/* Microsoft Clarity — behavioral analytics (heatmaps, session recordings, scroll maps) */}
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wri6wxtez2");
    </script>

    {/* Facebook Pixel (client-side) + dual fire to /api/fb-event for CAPI server-side */}
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '189022943393553');

      // Shared event_id for browser + server dedup
      var pthEventId = 'pv_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
      fbq('track', 'PageView', {}, { eventID: pthEventId });

      try {
        fetch('/api/fb-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_name: 'PageView',
            event_id: pthEventId,
            event_source_url: window.location.href,
          }),
          keepalive: true,
        }).catch(function () { /* swallow — Clarity still covers behavior */ });
      } catch (_) {}
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=189022943393553&ev=PageView&noscript=1"
    /></noscript>
  </head>
  <body class="flex min-h-screen flex-col bg-seasalt text-jet">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
