---
import { SITE } from '../config';

interface Props {
  author: string;
}

const { author } = Astro.props;
---

<section
  class="mt-16 rounded-xl border border-muted/30 bg-white p-6 md:flex md:items-center md:gap-6 md:p-8"
  aria-label="About the author"
>
  <div class="flex shrink-0 items-center gap-4 md:block">
    <img
      src="/logos/emblem-dark-green.svg"
      alt={`${author} avatar`}
      width="80"
      height="80"
      class="h-16 w-16 rounded-full bg-seasalt p-2 ring-2 ring-accent-light md:h-20 md:w-20"
    />
    <div class="md:hidden">
      <p class="text-xs uppercase tracking-wider text-accent">Written by</p>
      <p class="font-heading text-lg font-bold text-primary">{author}</p>
    </div>
  </div>

  <div class="mt-4 md:mt-0 md:flex-1">
    <p class="hidden text-xs uppercase tracking-wider text-accent md:block">Written by</p>
    <p class="hidden font-heading text-xl font-bold text-primary md:block">{author}</p>
    <p class="mt-2 text-base leading-relaxed text-jet/85">
      Founder of {SITE.name}. Helps coaches install productized offers, sales pages, and
      client acquisition systems that run on their own terms — 10 to 20 hours a week, without
      the sales-call grind.
    </p>
    <div class="mt-4 flex flex-wrap gap-3 text-sm">
      <a href={SITE.social.youtube} class="text-secondary hover:text-accent">YouTube</a>
      <span class="text-muted" aria-hidden="true">·</span>
      <a href={SITE.social.instagram} class="text-secondary hover:text-accent">Instagram</a>
      <span class="text-muted" aria-hidden="true">·</span>
      <a href={SITE.social.facebook} class="text-secondary hover:text-accent">Facebook</a>
      <span class="text-muted" aria-hidden="true">·</span>
      <a href={SITE.social.skool} class="text-secondary hover:text-accent">Free community</a>
    </div>
  </div>
</section>
