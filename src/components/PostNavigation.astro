---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav
    class="mt-20 grid gap-4 border-t border-muted/20 pt-10 md:grid-cols-2"
    aria-label="More posts"
  >
    {prev ? (
      <a
        href={`/blog/${prev.id}/`}
        class="group rounded-xl border border-muted/25 bg-white p-5 transition-shadow hover:shadow-md md:p-6"
      >
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
          &larr; Previous
        </p>
        <p class="mt-2 font-heading text-lg font-bold text-primary group-hover:text-secondary md:text-xl">
          {prev.data.title}
        </p>
        {prev.data.subtitle && (
          <p class="mt-1 text-sm text-jet/70">{prev.data.subtitle}</p>
        )}
      </a>
    ) : (
      <div class="hidden md:block" />
    )}

    {next ? (
      <a
        href={`/blog/${next.id}/`}
        class="group rounded-xl border border-muted/25 bg-white p-5 transition-shadow hover:shadow-md md:p-6 md:text-right"
      >
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
          Next &rarr;
        </p>
        <p class="mt-2 font-heading text-lg font-bold text-primary group-hover:text-secondary md:text-xl">
          {next.data.title}
        </p>
        {next.data.subtitle && (
          <p class="mt-1 text-sm text-jet/70">{next.data.subtitle}</p>
        )}
      </a>
    ) : (
      <div class="hidden md:block" />
    )}
  </nav>
)}
