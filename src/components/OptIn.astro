---
import { SITE } from '../config';

// PUBLIC env var inlined at build time. Set in Vercel:
// PUBLIC_OPTIN_ENDPOINT=https://api.leadconnectorhq.com/widget/form/<formId>
// Until then the form posts to a placeholder action and renders a Skool fallback line.
const formAction = import.meta.env.PUBLIC_OPTIN_ENDPOINT || '#opt-in-not-wired';
const isWired = formAction !== '#opt-in-not-wired';
---

<aside
  id="opt-in"
  class="my-16 rounded-2xl bg-primary px-6 py-8 text-seasalt md:px-10 md:py-12"
  aria-label="Daily email signup"
>
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-light">
    Daily emails
  </p>
  <h2 class="mt-3 max-w-2xl font-heading text-2xl leading-tight text-seasalt md:text-4xl">
    One short email a day from Zac.
  </h2>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-seasalt/85 md:text-lg">
    Plays, frameworks, and behind-the-scenes lessons for coaches building productized
    businesses. No fluff. Unsubscribe anytime.
  </p>

  <form
    action={formAction}
    method="POST"
    class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-stretch"
    data-wired={isWired}
  >
    <label class="sr-only" for="optin-email">Email address</label>
    <input
      id="optin-email"
      type="email"
      name="email"
      required
      placeholder="you@yourdomain.com"
      autocomplete="email"
      class="flex-1 rounded-lg border-2 border-transparent bg-seasalt px-4 py-3 text-base text-jet placeholder:text-muted focus:border-accent focus:outline-none"
    />
    <button
      type="submit"
      class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-seasalt transition-colors hover:bg-accent-light hover:text-primary md:text-base"
    >
      Sign me up &rarr;
    </button>
  </form>

  {!isWired && (
    <p class="mt-3 text-xs italic text-seasalt/60">
      Or join the <a href={SITE.social.skool} class="underline hover:text-accent-light">free Skool community</a> for now.
    </p>
  )}
</aside>
