---
// GoHighLevel-hosted form, wrapped in our branded card.
// The form_embed.js script auto-resizes the iframe to match form content height.
---

<aside
  id="opt-in"
  class="my-16 rounded-2xl bg-primary px-6 py-8 text-seasalt md:px-10 md:py-12"
  aria-label="Daily email signup"
>
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-light">
    Daily emails
  </p>
  <h2 class="mt-3 max-w-2xl font-heading text-2xl leading-tight text-seasalt md:text-4xl">
    One short email a day from Zac.
  </h2>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-seasalt/85 md:text-lg">
    Plays, frameworks, and behind-the-scenes lessons for coaches building productized
    businesses. No fluff. Unsubscribe anytime.
  </p>

  <div class="mt-6 overflow-hidden rounded-lg bg-white" style="min-height:430px">
    <iframe
      src="https://api.leadconnectorhq.com/widget/form/sDRaigU38umIRA3L8z5f"
      style="width:100%;min-height:430px;height:430px;border:none;display:block;background:#fff"
      id="inline-sDRaigU38umIRA3L8z5f"
      data-layout={'{"id":"INLINE"}'}
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Productized Coach Blog post Form"
      data-height="430"
      data-layout-iframe-id="inline-sDRaigU38umIRA3L8z5f"
      data-form-id="sDRaigU38umIRA3L8z5f"
      title="Productized Coach Blog post Form"
      scrolling="no"
    ></iframe>
  </div>
</aside>

<script src="https://link.msgsndr.com/js/form_embed.js" is:inline async></script>
