---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
// Only show H2s in the TOC for clean scannability
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 2 && (
  <nav
    class="mb-10 rounded-lg border border-muted/30 bg-white p-5 md:p-6"
    aria-labelledby="toc-heading"
  >
    <p id="toc-heading" class="text-xs font-semibold uppercase tracking-wider text-accent">
      In this article
    </p>
    <ol class="mt-3 space-y-2 text-base">
      {items.map((item, i) => (
        <li class="flex gap-3">
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
          <a href={`#${item.slug}`} class="text-jet hover:text-secondary">
            {item.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
