---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  sticky?: boolean;
}

const { headings, sticky = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 2 && (
  <nav
    class={`my-10 ${sticky ? 'border-l-2 border-muted/30 pl-5' : 'rounded-xl border border-muted/25 bg-white p-5 md:p-6'}`}
    aria-labelledby="toc-heading"
  >
    <p id="toc-heading" class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
      In this article
    </p>
    <ol class="mt-4 space-y-3 text-sm">
      {items.map((item, i) => (
        <li class="flex gap-3 leading-snug">
          <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
          <a href={`#${item.slug}`} class="text-jet/85 transition-colors hover:text-secondary">
            {item.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
