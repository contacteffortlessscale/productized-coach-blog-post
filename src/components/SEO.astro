---
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    author: string;
    tags?: string[];
  };
}

const { title, description = SITE.description, image = SITE.ogImage, article } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Prefer the 1200x630 OG variant when the image is a /covers/<slug>.png hero image.
// /og/<slug>.png is generated by scripts/generate-og-images.mjs.
const ogImagePath = image.startsWith('/covers/') ? image.replace('/covers/', '/og/') : image;
const imageURL = new URL(ogImagePath, Astro.site).toString();

const fullTitle = title === SITE.title ? title : `${title} | ${SITE.name}`;

// Google Search Console verification meta tag (paste verification code as Vercel env var)
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
// Bing Webmaster Tools verification (same pattern)
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.mainSiteUrl,
  logo: new URL('/logos/emblem-dark-green.svg', Astro.site).toString(),
  founder: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.mainSiteUrl,
    sameAs: [
      SITE.social.youtube,
      SITE.social.instagram,
      SITE.social.facebook,
    ],
  },
  sameAs: [
    SITE.social.youtube,
    SITE.social.instagram,
    SITE.social.facebook,
    SITE.social.skool,
    SITE.social.funnels,
  ],
};

// Person schema for Zac specifically — feeds Google Knowledge Graph + E-E-A-T
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  url: SITE.mainSiteUrl,
  jobTitle: 'Founder',
  worksFor: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.mainSiteUrl,
  },
  sameAs: [
    SITE.social.youtube,
    SITE.social.instagram,
    SITE.social.facebook,
    SITE.social.skool,
  ],
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: imageURL,
      datePublished: article.publishedTime.toISOString(),
      dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
      author: {
        '@type': 'Organization',
        name: article.author,
        url: SITE.mainSiteUrl,
      },
      creator: {
        '@type': 'Person',
        name: SITE.author.name,
        url: SITE.mainSiteUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/logos/emblem-dark-green.svg', Astro.site).toString(),
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
      keywords: article.tags?.join(', '),
    }
  : null;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={article?.author ?? SITE.author.name} />
<link rel="canonical" href={canonicalURL} />

{/* Search engine verification (Vercel env vars: PUBLIC_GSC_VERIFICATION, PUBLIC_BING_VERIFICATION) */}
{gscVerification && <meta name="google-site-verification" content={gscVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

{/* rel="me" social profile verification — used by Mastodon-style identity verification and helps Google associate this site with the author's social profiles */}
<link rel="me" href={SITE.social.youtube} />
<link rel="me" href={SITE.social.instagram} />
<link rel="me" href={SITE.social.facebook} />
<link rel="me" href={SITE.social.skool} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={SITE.locale} />

{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
    )}
    <meta property="article:author" content={article.author} />
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS Feed`} href={new URL('/rss.xml', Astro.site)} />

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
