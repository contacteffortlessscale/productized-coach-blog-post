---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { estimateReadTime } from '../lib/readTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;
const featuredReadTime = featured ? estimateReadTime(featured.body ?? '').minutes : 0;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const shortDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={SITE.title} description={SITE.description}>
  {/* Editorial intro */}
  <section class="mx-auto max-w-7xl px-5 pt-12 md:pt-20 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">
      The Productized Coach Journal
    </p>
    <h1 class="mt-4 max-w-4xl font-heading text-4xl leading-[1.05] tracking-tight text-primary md:text-6xl lg:text-7xl">
      Build a coaching business <span class="italic text-secondary">on your own terms.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-jet/80 md:text-xl">
      {SITE.description}
    </p>
  </section>

  {/* Featured / latest post */}
  {featured && (
    <section class="mx-auto mt-16 max-w-7xl px-5 md:mt-24 lg:px-8" aria-label="Featured post">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Latest</p>
      <a
        href={`/blog/${featured.id}/`}
        class="group mt-6 grid items-start gap-8 md:grid-cols-2 md:gap-12 lg:gap-16"
      >
        {featured.data.heroImage && (
          <div class="overflow-hidden rounded-xl">
            <img
              src={featured.data.heroImage}
              alt=""
              width="900"
              height="600"
              class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
        )}
        <div class="self-center">
          {featured.data.tags.length > 0 && (
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
              {featured.data.tags[0]}
            </p>
          )}
          <h2 class="mt-4 font-heading text-3xl leading-[1.1] tracking-tight text-primary group-hover:text-secondary md:text-5xl lg:text-6xl">
            {featured.data.title}
          </h2>
          {featured.data.subtitle && (
            <p class="mt-4 font-heading text-lg italic leading-snug text-jet/80 md:text-xl">
              {featured.data.subtitle}
            </p>
          )}
          <p class="mt-5 text-base leading-relaxed text-jet/80 md:text-lg">
            {featured.data.description}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-jet/65">
            <time datetime={featured.data.pubDate.toISOString()}>
              {dateFormatter.format(featured.data.pubDate)}
            </time>
            <span class="text-muted" aria-hidden="true">·</span>
            <span>{featuredReadTime} min read</span>
          </div>
        </div>
      </a>
    </section>
  )}

  {/* Earlier posts grid */}
  {rest.length > 0 && (
    <section class="mx-auto mt-24 max-w-7xl px-5 md:mt-32 lg:px-8" aria-label="More posts">
      <div class="flex items-end justify-between border-b border-muted/30 pb-5">
        <h2 class="font-heading text-2xl text-primary md:text-3xl">More from the Journal</h2>
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
          {rest.length} {rest.length === 1 ? 'article' : 'articles'}
        </p>
      </div>
      <ul class="mt-10 grid gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-14 lg:gap-x-14">
        {rest.map((post) => {
          const minutes = estimateReadTime(post.body ?? '').minutes;
          return (
            <li>
              <a href={`/blog/${post.id}/`} class="group block">
                {post.data.heroImage && (
                  <div class="overflow-hidden rounded-lg">
                    <img
                      src={post.data.heroImage}
                      alt=""
                      width="600"
                      height="400"
                      loading="lazy"
                      class="aspect-[3/2] w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                {post.data.tags.length > 0 && (
                  <p class="mt-5 text-xs font-semibold uppercase tracking-[0.15em] text-accent">
                    {post.data.tags[0]}
                  </p>
                )}
                <h3 class="mt-3 font-heading text-2xl leading-tight tracking-tight text-primary group-hover:text-secondary md:text-3xl">
                  {post.data.title}
                </h3>
                {post.data.subtitle && (
                  <p class="mt-3 font-heading text-base italic leading-snug text-jet/75 md:text-lg">
                    {post.data.subtitle}
                  </p>
                )}
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-jet/60">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {shortDate.format(post.data.pubDate)}
                  </time>
                  <span class="text-muted" aria-hidden="true">·</span>
                  <span>{minutes} min read</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>
