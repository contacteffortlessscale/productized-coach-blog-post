---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import MidArticleCTA from '../../components/MidArticleCTA.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { estimateReadTime } from '../../lib/readTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const { minutes: readMinutes } = estimateReadTime(post.body ?? '');
const showTOC = headings.filter((h) => h.depth === 2).length >= 3;

// Sort other posts by tag overlap (descending), then by date desc; take top 3.
const otherPosts = allPosts.filter((p) => p.id !== post.id);
const tagSet = new Set(post.data.tags);
const related = otherPosts
  .map((p) => {
    const overlap = p.data.tags.filter((t) => tagSet.has(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => {
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .slice(0, 3)
  .map((x) => x.post);

const faqSchema = post.data.faq && post.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  {post.data.heroImage && (
    <div class="mx-auto mt-6 max-w-5xl px-5 md:mt-10">
      <img
        src={post.data.heroImage}
        alt={post.data.title}
        width="1536"
        height="1024"
        class="w-full rounded-lg object-cover shadow-sm md:rounded-xl"
      />
    </div>
  )}

  <article class="mx-auto max-w-3xl px-5 pt-10 md:pt-12">
    <header class="mb-10 border-b border-muted/20 pb-8">
      <p class="text-sm uppercase tracking-wide text-accent">
        {dateFormatter.format(post.data.pubDate)}
        {post.data.updatedDate && (
          <span class="text-muted"> · updated {dateFormatter.format(post.data.updatedDate)}</span>
        )}
        <span class="text-muted"> · {readMinutes} min read</span>
      </p>
      <h1 class="mt-3 font-heading text-3xl leading-tight text-primary md:text-5xl">
        {post.data.title}
      </h1>
      {post.data.subtitle && (
        <p class="mt-4 font-heading text-xl italic leading-snug text-jet/85 md:text-2xl">
          {post.data.subtitle}
        </p>
      )}
      <p class="mt-5 text-lg text-jet/80">{post.data.description}</p>
      <p class="mt-6 text-sm text-jet/60">By {post.data.author}</p>
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-accent-light/30 px-3 py-1 text-xs font-medium text-primary">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {post.data.tldr && (
      <aside
        class="mb-10 rounded-lg border border-accent-light bg-accent-light/15 p-5 md:p-6"
        aria-label="Summary"
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">TL;DR</p>
        <p class="mt-2 text-base leading-relaxed text-jet md:text-lg">{post.data.tldr}</p>
      </aside>
    )}

    {showTOC && <TableOfContents headings={headings} />}

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <MidArticleCTA />

    {post.data.faq && post.data.faq.length > 0 && (
      <section class="mt-16 border-t border-muted/20 pt-10" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-heading text-2xl text-primary md:text-3xl">
          Frequently asked questions
        </h2>
        <div class="mt-6 space-y-6">
          {post.data.faq.map((item) => (
            <details class="group rounded-lg border border-muted/30 bg-white p-5 transition-shadow open:shadow-sm">
              <summary class="cursor-pointer list-none font-heading text-lg font-bold text-primary marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{item.question}</span>
                  <span class="mt-1 text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-jet/90">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <AuthorCard author={post.data.author} />

    <RelatedPosts posts={related} />

    <footer class="mt-16 border-t border-muted/20 pt-8">
      <a href="/" class="text-secondary hover:text-accent">&larr; Back to all posts</a>
    </footer>
  </article>

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</BaseLayout>
