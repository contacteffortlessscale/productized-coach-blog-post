---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import MidArticleCTA from '../../components/MidArticleCTA.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import { estimateReadTime } from '../../lib/readTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const { minutes: readMinutes } = estimateReadTime(post.body ?? '');
const showTOC = headings.filter((h) => h.depth === 2).length >= 3;

const otherPosts = allPosts.filter((p) => p.id !== post.id);
const tagSet = new Set(post.data.tags);
const related = otherPosts
  .map((p) => {
    const overlap = p.data.tags.filter((t) => tagSet.has(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => {
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .slice(0, 3)
  .map((x) => x.post);

// Compute prev/next based on chronological order (newest first list)
const sortedByDate = [...allPosts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = sortedByDate.findIndex((p) => p.id === post.id);
const newerPost = currentIndex > 0 ? sortedByDate[currentIndex - 1] : null;
const olderPost = currentIndex < sortedByDate.length - 1 ? sortedByDate[currentIndex + 1] : null;

const faqSchema = post.data.faq && post.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  <ReadingProgress />

  {/* Editorial header — title, dek, byline above any image */}
  <header class="mx-auto max-w-3xl px-5 pt-12 md:pt-20">
    {post.data.tags.length > 0 && (
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.15em] text-accent">
        {post.data.tags[0]}
      </p>
    )}

    <h1 class="font-heading text-4xl leading-[1.05] tracking-tight text-primary md:text-6xl lg:text-7xl">
      {post.data.title}
    </h1>

    {post.data.subtitle && (
      <p class="mt-6 font-heading text-xl italic leading-snug text-jet/80 md:text-2xl">
        {post.data.subtitle}
      </p>
    )}

    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-jet/65">
      <span>{post.data.author}</span>
      <span class="text-muted" aria-hidden="true">·</span>
      <span>Based on the teachings of Zac Hansen</span>
      <span class="text-muted" aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {dateFormatter.format(post.data.pubDate)}
      </time>
      <span class="text-muted" aria-hidden="true">·</span>
      <span>{readMinutes} min read</span>
    </div>
  </header>

  {post.data.heroImage && (
    <div class="mx-auto mt-10 max-w-5xl px-5 md:mt-14">
      <img
        src={post.data.heroImage}
        alt={post.data.title}
        width="1536"
        height="1024"
        class="w-full rounded-lg object-cover shadow-sm md:rounded-xl"
      />
    </div>
  )}

  <div class="mx-auto mt-10 max-w-7xl px-5 md:mt-16 lg:px-8">
    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">
      <article class="mx-auto w-full max-w-3xl lg:mx-0">
        {post.data.tldr && (
          <aside
            class="mb-12 rounded-xl border-l-4 border-accent bg-white p-6 shadow-sm md:p-7"
            aria-label="Summary"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">TL;DR</p>
            <p class="mt-3 text-lg leading-relaxed text-jet md:text-xl">{post.data.tldr}</p>
          </aside>
        )}

        {/* Inline TOC for mobile/tablet (sidebar version handles desktop) */}
        {showTOC && (
          <div class="lg:hidden">
            <TableOfContents headings={headings} sticky={false} />
          </div>
        )}

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        <MidArticleCTA />

        {post.data.faq && post.data.faq.length > 0 && (
          <section class="mt-20 border-t border-muted/20 pt-12" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="font-heading text-3xl text-primary md:text-4xl">
              Frequently asked questions
            </h2>
            <div class="mt-8 space-y-4">
              {post.data.faq.map((item) => (
                <details class="group rounded-xl border border-muted/25 bg-white p-5 transition-shadow open:shadow-sm md:p-6">
                  <summary class="cursor-pointer list-none font-heading text-lg font-bold text-primary marker:hidden md:text-xl">
                    <span class="flex items-start justify-between gap-4">
                      <span>{item.question}</span>
                      <span
                        class="mt-1 shrink-0 text-2xl leading-none text-accent transition-transform group-open:rotate-45"
                        aria-hidden="true"
                      >+</span>
                    </span>
                  </summary>
                  <p class="mt-4 leading-relaxed text-jet/90">{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <RelatedPosts posts={related} />

        <PostNavigation prev={olderPost} next={newerPost} />

        <footer class="mt-12 border-t border-muted/20 pt-8">
          <a href="/" class="text-secondary hover:text-accent">&larr; Back to all posts</a>
        </footer>
      </article>

      {/* Sticky sidebar TOC on desktop only */}
      {showTOC && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <TableOfContents headings={headings} sticky={true} />
          </div>
        </aside>
      )}
    </div>
  </div>

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</BaseLayout>
